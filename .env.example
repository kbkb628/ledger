# 判定服务配置（OpenAI 兼容）。复制为 .env 后填入真实值。
# 本文件不会进版本库（见 .gitignore）。

# ── 方案 A：DeepSeek 官方（当前使用）──────────────────────────
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用。
# 现役只有两个模型，旧名 deepseek-v4-flash 虽可调用但模型已下线。
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-v4-pro
JUDGE_API_KEY=

# 价格（美元 / 百万 token），仅用于成本统计。DeepSeek 空闲时段为高峰的一半，
# 这里按**高峰**折算（保守）：1 元 ≈ $0.14
JUDGE_PRICE_IN=1.27
JUDGE_PRICE_OUT=3.80

# 换更便宜的 V4.1-Flash（贵 5 倍以下的成本，但能力可能弱一些）：
#   JUDGE_MODEL=deepseek-flash
#   JUDGE_PRICE_IN=0.28
#   JUDGE_PRICE_OUT=1.13

# ── 方案 B：春风API（此前接口不通，暂不启用）──────────────────
# JUDGE_BASE_URL=https://chunfeng.mentalout.top/v1
# JUDGE_MODEL=gpt-6-astra
# JUDGE_PRICE_IN=6
# JUDGE_PRICE_OUT=30

# ── JEV（TypeSafe System One，走 OpenRouter Decisions API）─────
# 用**独立变量名**，因此可与上面的 DeepSeek 配置共存，用 --provider 切换：
#   npm run eval -- --provider jev
# key 在 https://openrouter.ai/settings/keys 创建（形如 sk-or-…）
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# JEV_BASE_URL 默认 https://openrouter.ai/api/alpha/decisions
# JEV_PRICE_IN  可选，美元/百万 input token，用于成本统计

# 默认 provider（rule | openai）。rule 不需要任何 key。
JUDGE_PROVIDER=rule
